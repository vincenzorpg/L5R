<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Création de Personnage | L5R 4e Édition</title>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Noto+Serif+JP:wght@400;600&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --dark-lacquer: #0b0909;
      --gold: #d4af37;
    }
    body {
      background-color: var(--dark-lacquer);
      color: #e5dec9;
      font-family: 'Noto Serif JP', serif;
    }
    h1, h2, h3, .font-imperial { font-family: 'Cinzel', serif; }
    .card-clean {
      background: rgba(20, 16, 16, 0.9);
      border: 1px solid rgba(212, 175, 55, 0.25);
    }
    .gold-text { color: var(--gold); }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- NAVIGATION RAPIDE -->
  <header class="py-6 px-6 border-b border-amber-500/20 text-center">
    <h1 class="text-2xl font-bold gold-text font-imperial">GÉNÉRATEUR DE PERSONNAGE (L5R 4E)</h1>
    <p class="text-xs text-stone-400 mt-1">Conforme aux règles officielles et au Manuel du Samouraï[span_3](start_span)[span_3](end_span)[span_4](start_span)[span_4](end_span)</p>
    <div class="mt-4 flex justify-center gap-3 text-xs">
      <a href="index.html" class="px-3 py-1.5 rounded bg-stone-900 text-amber-300 border border-stone-800 hover:border-amber-500">← Retour Accueil</a>
    </div>
  </header>

  <!-- CONTENU PRINCIPAL -->
  <main class="flex-1 max-w-4xl w-full mx-auto p-4 md:p-6 space-y-6">

    <!-- ÉTAPE 1 : IDENTITÉ & CLAN -->
    <div class="card-clean rounded-xl p-5 space-y-4">
      <h2 class="text-lg font-bold gold-text">1. Identité & Clan Majeur</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div>
          <label class="block text-stone-400 mb-1">Nom du Samouraï</label>
          <input type="text" id="pc-name" value="Okado Hiruma" class="w-full p-2 rounded bg-black border border-stone-800 text-amber-200">
        </div>
        <div>
          <label class="block text-stone-400 mb-1">Clan Majeur</label>
          <select id="pc-clan" class="w-full p-2 rounded bg-black border border-stone-800 text-amber-200">
            <option value="Crabe">Clan du Crabe[span_5](start_span)[span_5](end_span)[span_6](start_span)[span_6](end_span)</option>
            <option value="Mante">Clan de la Mante[span_7](start_span)[span_7](end_span)[span_8](start_span)[span_8](end_span)</option>
            <option value="Grue">Clan de la Grue[span_9](start_span)[span_9](end_span)[span_10](start_span)[span_10](end_span)</option>
            <option value="Licorne">Clan de la Licorne[span_11](start_span)[span_11](end_span)[span_12](start_span)[span_12](end_span)</option>
            <option value="Dragon">Clan du Dragon[span_13](start_span)[span_13](end_span)[span_14](start_span)[span_14](end_span)</option>
            <option value="Lion">Clan du Lion[span_15](start_span)[span_15](end_span)[span_16](start_span)[span_16](end_span)</option>
            <option value="Phenix">Clan du Phénix[span_17](start_span)[span_17](end_span)[span_18](start_span)[span_18](end_span)</option>
            <option value="Scorpion">Clan du Scorpion[span_19](start_span)[span_19](end_span)[span_20](start_span)[span_20](end_span)</option>
          </select>
        </div>
        <div>
          <label class="block text-stone-400 mb-1">Rôle / École</label>
          <input type="text" id="pc-school" value="Bushi Hiruma" class="w-full p-2 rounded bg-black border border-stone-800 text-amber-200">
        </div>
      </div>
    </div>

    <!-- ÉTAPE 2 : LES 5 ANNEAUX & TRAITS -->
    <div class="card-clean rounded-xl p-5 space-y-4">
      <div class="flex justify-between items-center">
        <h2 class="text-lg font-bold gold-text">2. Les 5 Anneaux & Traits (Base : 2)</h2>
        <span class="text-xs text-amber-400">Points d'Expérience (XP) restants : <b id="xp-left">40</b> / 40</span>
      </div>
      <p class="text-xs text-stone-400">Chaque Anneau est la moyenne de ses 2 Traits associés. Augmenter un Trait coûte 4 × Rang suivant[span_21](start_span)[span_21](end_span).</p>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 text-xs text-center">
        <!-- Terre -->
        <div class="p-3 rounded bg-black/60 border border-amber-900/40 space-y-2">
          <div class="font-bold text-amber-300">土 Terre</div>
          <div>Stamina: <input type="number" id="t-stamina" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div>Will: <input type="number" id="t-will" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div class="text-[11px] text-stone-400 pt-1 border-t border-stone-800">Anneau : <span id="ring-terre" class="font-bold text-amber-300">2</span></div>
        </div>
        <!-- Eau -->
        <div class="p-3 rounded bg-black/60 border border-blue-900/40 space-y-2">
          <div class="font-bold text-blue-300">水 Eau</div>
          <div>Strength: <input type="number" id="w-strength" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div>Perception: <input type="number" id="w-perc" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div class="text-[11px] text-stone-400 pt-1 border-t border-stone-800">Anneau : <span id="ring-eau" class="font-bold text-blue-300">2</span></div>
        </div>
        <!-- Air -->
        <div class="p-3 rounded bg-black/60 border border-teal-900/40 space-y-2">
          <div class="font-bold text-teal-300">風 Air</div>
          <div>Reflexes: <input type="number" id="a-reflex" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div>Awareness: <input type="number" id="a-aware" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div class="text-[11px] text-stone-400 pt-1 border-t border-stone-800">Anneau : <span id="ring-air" class="font-bold text-teal-300">2</span></div>
        </div>
        <!-- Feu -->
        <div class="p-3 rounded bg-black/60 border border-red-900/40 space-y-2">
          <div class="font-bold text-red-300">火 Feu</div>
          <div>Agility: <input type="number" id="f-agi" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div>Intelligence: <input type="number" id="f-intel" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded"></div>
          <div class="text-[11px] text-stone-400 pt-1 border-t border-stone-800">Anneau : <span id="ring-feu" class="font-bold text-red-300">2</span></div>
        </div>
        <!-- Vide -->
        <div class="p-3 rounded bg-black/60 border border-purple-900/40 space-y-2 flex flex-col justify-between">
          <div class="font-bold text-purple-300">空 Vide</div>
          <div>Void Trait: <input type="number" id="v-trait" value="2" min="2" max="6" oninput="calculateSheet()" class="w-12 bg-stone-900 text-center font-bold text-amber-200 rounded mt-2"></div>
          <div class="text-[11px] text-stone-400 pt-1 border-t border-stone-800">Anneau : <span id="ring-vide" class="font-bold text-purple-300">2</span></div>
        </div>
      </div>
    </div>

    <!-- ÉTAPE 3 : STATISTIQUES DÉRIVÉES & COMBAT -->
    <div class="card-clean rounded-xl p-5 space-y-3">
      <h2 class="text-lg font-bold gold-text">3. Statistiques & Combat (Calculé Automatiquement)</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
        <div class="p-3 rounded bg-black/50 border border-stone-800 text-center">
          <div class="text-stone-400">Réputation (Insight)[span_22](start_span)[span_22](end_span)[span_23](start_span)[span_23](end_span)</div>
          <div id="out-insight" class="text-lg font-bold gold-text mt-1">100</div>
        </div>
        <div class="p-3 rounded bg-black/50 border border-stone-800 text-center">
          <div class="text-stone-400">ND d'Armure[span_24](start_span)[span_24](end_span)[span_25](start_span)[span_25](end_span)</div>
          <div id="out-armor" class="text-lg font-bold text-emerald-400 mt-1">15</div>
        </div>
        <div class="p-3 rounded bg-black/50 border border-stone-800 text-center">
          <div class="text-stone-400">Initiative[span_26](start_span)[span_26](end_span)[span_27](start_span)[span_27](end_span)</div>
          <div id="out-init" class="text-lg font-bold text-amber-300 mt-1">2g2</div>
        </div>
        <div class="p-3 rounded bg-black/50 border border-stone-800 text-center">
          <div class="text-stone-400">Seuils de Blessures (Indemne)[span_28](start_span)[span_28](end_span)[span_29](start_span)[span_29](end_span)</div>
          <div id="out-wounds" class="text-lg font-bold text-red-400 mt-1">10 PV</div>
        </div>
      </div>
    </div>

    <!-- BOUTON SAUVEGARDE / EXPORT -->
    <div class="text-center pt-2">
      <button onclick="alert('Fiche validée selon les règles de la 4e Édition de L5R ! Vous pouvez lier ce formulaire à un stockage local ou GitHub.')" class="px-6 py-3 rounded bg-amber-600 hover:bg-amber-500 text-black font-bold text-xs uppercase tracking-wider transition shadow-lg">
        💾 Valider et Enregistrer la Fiche Samouraï
      </button>
    </div>

  </main>

  <footer class="py-4 text-center text-[10px] text-stone-600 border-t border-stone-900">
    Campagne L5R – Module de Création de Personnage • GitHub Pages[span_30](start_span)[span_30](end_span)[span_31](start_span)[span_31](end_span)
  </footer>

  <script>
    function calculateSheet() {
      // Récupération des traits
      const st = parseInt(document.getElementById('t-stamina').value) || 2;
      const wil = parseInt(document.getElementById('t-will').value) || 2;
      const str = parseInt(document.getElementById('w-strength').value) || 2;
      const per = parseInt(document.getElementById('w-perc').value) || 2;
      const ref = parseInt(document.getElementById('a-reflex').value) || 2;
      const awa = parseInt(document.getElementById('a-aware').value) || 2;
      const agi = parseInt(document.getElementById('f-agi').value) || 2;
      const int = parseInt(document.getElementById('f-intel').value) || 2;
      const voidT = parseInt(document.getElementById('v-trait').value) || 2;

      // Calcul des Anneaux (minimum des deux traits associés)
      const rTerre = Math.min(st, wil);
      const rEau = Math.min(str, per);
      const rAir = Math.min(ref, awa);
      const rFeu = Math.min(agi, int);
      const rVide = voidT;

      document.getElementById('ring-terre').innerText = rTerre;
      document.getElementById('ring-eau').innerText = rEau;
      document.getElementById('ring-air').innerText = rAir;
      document.getElementById('ring-feu').innerText = rFeu;
      document.getElementById('ring-vide').innerText = rVide;

      // Calcul Insight (Somme des Anneaux x 10 + Compétences estimées à 20 de base pour un rang 1)
      const sumRings = rTerre + rEau + rAir + rFeu + rVide;
      const insight = (sumRings * 10) + 20;
      document.getElementById('out-insight').innerText = insight;

      // ND d'Armure = 5 + (5 x Réflexes) + Armure (ex: 5 de base)[span_32](start_span)[span_32](end_span)[span_33](start_span)[span_33](end_span)
      const armorTN = 5 + (5 * ref) + 5;
      document.getElementById('out-armor').innerText = armorTN;

      // Initiative = Reflexes g Reflexes (simplifié ici en affichage)[span_34](start_span)[span_34](end_span)[span_35](start_span)[span_35](end_span)
      document.getElementById('out-init').innerText = `${ref}g${ref}`;

      // Blessures (Indemne = Terre x 5)[span_36](start_span)[span_36](end_span)[span_37](start_span)[span_37](end_span)
      const healthyWounds = rTerre * 5;
      document.getElementById('out-wounds').innerText = `${healthyWounds} PV`;
    }

    // Calcul initial au chargement
    calculateSheet();
  </script>
</body>
</html>
